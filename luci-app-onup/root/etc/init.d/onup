#!/bin/sh /etc/rc.common
# Copyright (C) 2026 ilxp <https://github.com/ilxp\>
# /etc/init.d/onup
#
# 从 UCI 读定时配置,生成 /etc/crontabs/root 中的 cron 任务
# 配置直接同步到 custom

START=99
STOP=10
# ★ 开启 procd，完美接管网页保存触发
USE_PROCD=1

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

LOGGER="logger -t '[onup]'"

Script_File="$(command -v onup)"
[ -z "$Script_File" ] && Script_File="/usr/bin/onup"
Script_Cmd="$Script_File -u"

CRONTAB="/etc/crontabs/root"
CRON_TAG="## onup crontab"
CUSTOM_FILE="/etc/onup/custom"

# ============================================================
# UCI 读取工具（读取 onup.main）
# ============================================================
uci_get_by_type() {
	local ret=$(uci -q get onup.main.$1)
	echo "${ret:=$2}"
}

# ============================================================
# 同步单个 key=value 到 custom（自带换行防粘连）
# ============================================================
sync_custom_kv() {
    local key="$1" val="$2"
    [ -f "$CUSTOM_FILE" ] || touch "$CUSTOM_FILE"

    [ -z "$val" ] && return 0

    local val_esc
    val_esc=$(printf '%s' "$val" | sed 's/[\/&|\\]/\\&/g')

    if grep -q "^${key}=" "$CUSTOM_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val_esc}|" "$CUSTOM_FILE"
    else
        # 追加前保证文件末尾有换行
        if [ -s "$CUSTOM_FILE" ] && [ "$(tail -c1 "$CUSTOM_FILE" | wc -l)" -eq 0 ]; then
            echo >> "$CUSTOM_FILE"
        fi
        echo "${key}=${val}" >> "$CUSTOM_FILE"
    fi
}

# ============================================================
# 删除旧 cron 任务
# ============================================================
remove_cron_tasks() {
	[ -f "$CRONTAB" ] || return 0
	sed -i "/$CRON_TAG/d" "$CRONTAB" 2> /dev/null
}

# ============================================================
# 启动服务（procd 调用）
# ============================================================
start_service() {
	# ---------- 1. 读 UCI 字段 ----------
	local enable schedule_type week day hour minute
	local api_url flag logpath
	local upgrade_no_config skip_verify force_flash decompress
	local mirror_list mirror_random mirror_retry x86_boot_method
	local downloader

	enable=$(uci_get_by_type enable 0)
	schedule_type=$(uci_get_by_type schedule_type weekly)
	week=$(uci_get_by_type week 0)
	day=$(uci_get_by_type day 1)
	hour=$(uci_get_by_type hour 0)
	minute=$(uci_get_by_type minute 30)
	api_url=$(uci_get_by_type api_url "")
	flag=$(uci_get_by_type flag "")
	logpath=$(uci_get_by_type logpath "")

	upgrade_no_config=$(uci_get_by_type upgrade_no_config 0)
	skip_verify=$(uci_get_by_type skip_verify 0)
	force_flash=$(uci_get_by_type force_flash 0)
	decompress=$(uci_get_by_type decompress 0)

	mirror_list=$(uci_get_by_type mirror_list "")
	mirror_random=$(uci_get_by_type mirror_random "")
	mirror_retry=$(uci_get_by_type mirror_retry "")
	x86_boot_method=$(uci_get_by_type x86_boot_method "")
	downloader=$(uci_get_by_type downloader "")

	# ---------- 2. 同步配置到 custom ----------
	sync_custom_kv "API_Url" "$api_url"
	sync_custom_kv "TARGET_FLAG" "$flag"
	sync_custom_kv "Log_Path" "$logpath"

	# 兼容 ash 的转小写方式
	local ml_lc=$(echo "$mirror_list" | tr '[:upper:]' '[:lower:]')
	case "$ml_lc" in
		"<direct>"|"direct"|"<none>"|"none"|"<off>"|"off")
			sync_custom_kv "Mirror_List" "<direct>"
			;;
		"")
			;;
		*)
			sync_custom_kv "Mirror_List" "$mirror_list"
			;;
	esac

	sync_custom_kv "Mirror_Random"    "$mirror_random"
	sync_custom_kv "Mirror_Retry"     "$mirror_retry"
	
	if [ -n "$x86_boot_method" ] && [ "$x86_boot_method" != "auto" ]; then
		sync_custom_kv "x86_Boot_Method" "$x86_boot_method"
	else
		sed -i '/^x86_Boot_Method=/d' "$CUSTOM_FILE" 2>/dev/null
	fi
	
	sync_custom_kv "Downloader"       "$downloader"

	# ---------- 3. 处理计划任务 ----------
	remove_cron_tasks

	if [ "$enable" != "1" ]; then
		${LOGGER} "onup Service is disabled ..."
		/etc/init.d/cron restart
		return 0
	fi

	[ -z "$hour" ]   && hour=0
	[ -z "$minute" ] && minute=30

	local cron_time
	case "$schedule_type" in
		monthly)
			[ -z "$day" ] && day=1
			[ "$day" -lt 1 ]  && day=1
			[ "$day" -gt 31 ] && day=31
			cron_time="$minute $hour $day * *"
			${LOGGER} "Schedule Type: Monthly (day=$day)"
		;;
		weekly|*)
			[ -z "$week" ] && week=0
			[ "$week" = "7" ] && week='*'
			cron_time="$minute $hour * * $week"
			${LOGGER} "Schedule Type: Weekly (week=$week)"
		;;
	esac

	local extra_args=""
	[ "$upgrade_no_config" = "1" ] && extra_args="$extra_args -n"
	[ "$skip_verify" = "1" ]       && extra_args="$extra_args --skip-verify"
	[ "$force_flash" = "1" ]       && extra_args="$extra_args -F"
	[ "$decompress" = "1" ]        && extra_args="$extra_args --decompress"

	${LOGGER} "Creating cron_task [$cron_time $Script_Cmd $extra_args] ..."
	echo "$cron_time $Script_Cmd $extra_args		$CRON_TAG" >> "$CRONTAB"
	/etc/init.d/cron restart

	# ============================================================
	# ★ 核心新增：检查前端传来的手动任务并执行
	# ============================================================
	local manual_cmd=$(uci -q get onup.main.manual_cmd)
	if [ -n "$manual_cmd" ]; then
		uci -q delete onup.main.manual_cmd
		uci commit onup
		
		local real_logpath="$logpath"
		[ -z "$real_logpath" ] && real_logpath="/tmp"
		echo "=== MANUAL UPGRADE $(date "+%Y-%m-%d %H:%M:%S") ===" > "${real_logpath}/onup.log"
		
		( /usr/bin/onup $manual_cmd >> "${real_logpath}/onup.log" 2>&1 </dev/null & )
	fi

	${LOGGER} "onup Service started."
}

# ============================================================
# 停止服务（procd 调用）
# ============================================================
stop_service() {
	${LOGGER} "Removing all cron tasks ..."
	remove_cron_tasks
	/etc/init.d/cron restart
}

# ============================================================
# 重载服务（当网页保存 UCI 时自动触发）
# ============================================================
reload_service() {
	stop_service
	start_service
}

# ============================================================
# procd reload 触发器（魔法核心）
# ============================================================
service_triggers() {
	procd_add_reload_trigger "onup"
}
